# This file was generated using idf.py save-defconfig or menuconfig [D] key. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.3.0 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s3"

#
# micro-ROS Settings
#

#
# WiFi Configuration
#
CONFIG_ESP_WIFI_SSID="narsu"
CONFIG_ESP_WIFI_PASSWORD="8848123456"
# end of WiFi Configuration

CONFIG_MICRO_ROS_AGENT_IP="10.189.154.53"

#
# Log output (降低串口噪音: WARN 级别只输出警告和错误)
#
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
# end of micro-ROS Settings

#
# Component config
#

#
# ESP System Settings
#
CONFIG_ESP_MAIN_TASK_STACK_SIZE=3000
CONFIG_ESP_TASK_WDT_INIT=n
# end of ESP System Settings
# end of Component config
